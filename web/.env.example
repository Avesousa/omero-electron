# Copiar a web/.env.local para desarrollo.

# Modo de ejecución (obligatoria): "web" (Railway / navegador) o "desktop" (dentro de Electron).
OMERO_RUNTIME=web

# Origen del omero-backend (obligatoria, sin path). Backend local de ./dev.sh:
BACKEND_URL=http://localhost:8080
# Railway: BACKEND_URL=https://omero-backend.up.railway.app

# Opcional: tiempo máximo (ms) hasta recibir los headers del backend. Default 30000.
# PROXY_TIMEOUT_MS=30000

# Solo desktop (OMERO_RUNTIME=desktop): caché SQLite del catálogo.
# Electron inyecta OMERO_DATA_DIR (<userData>/catalog-cache) y OMERO_SQLITE_BINDING (binario de Electron).
# En desarrollo sin definir: se usa web/.data (ignorado por git) y el binding por defecto de tu Node.
# OMERO_DATA_DIR=
# OMERO_SQLITE_BINDING=
# CATALOG_SYNC_INTERVAL_MS=300000

# Opcional: logs remotos.
# BETTERSTACK_TOKEN=

# No definir NEXT_PUBLIC_API_URL: el POS llama a /api/* del mismo origen y el proxy reenvía al backend.
