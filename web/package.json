{
  "name": "omero-pos-web",
  "version": "0.1.0",
  "private": true,
  "description": "Omero POS — Next.js app (modo web en Railway y modo desktop dentro de Electron)",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
