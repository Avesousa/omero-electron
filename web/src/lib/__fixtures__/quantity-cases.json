{
  "_comment": "Casos compartidos entre QuantityMathTest (backend) y lib/quantity.test.ts (POS y admin). Si cambia una regla, cambia acá y en las tres copias del cálculo. Decimales como texto para no perder precisión.",
  "cases": [
    { "name": "UNIT: 3 unidades",
      "product": { "saleFormat": "UNIT", "costPrice": "50", "sellingPrice": "100", "rounding": 0 },
      "unit": "UNIT", "quantity": "3",
      "expect": { "valid": true, "stockQty": "3.000", "unitCost": "50.0000", "unitPrice": "100.00", "lineTotal": "300.00" } },
    { "name": "UNIT: no admite kg",
      "product": { "saleFormat": "UNIT", "costPrice": "50", "sellingPrice": "100", "rounding": 0 },
      "unit": "KG", "quantity": "0.5", "expect": { "valid": false } },
    { "name": "UNIT: la cantidad debe ser entera",
      "product": { "saleFormat": "UNIT", "costPrice": "50", "sellingPrice": "100", "rounding": 0 },
      "unit": "UNIT", "quantity": "1.5", "expect": { "valid": false } },
    { "name": "UNIT: cantidad 0",
      "product": { "saleFormat": "UNIT", "costPrice": "50", "sellingPrice": "100", "rounding": 0 },
      "unit": "UNIT", "quantity": "0", "expect": { "valid": false } },
    { "name": "GRAMS: 0,350 kg",
      "product": { "saleFormat": "GRAMS", "costPrice": "7000", "sellingPrice": "12000", "rounding": 0 },
      "unit": "KG", "quantity": "0.350",
      "expect": { "valid": true, "stockQty": "0.350", "unitCost": "7000.0000", "unitPrice": "12000.00", "lineTotal": "4200.00" } },
    { "name": "GRAMS: 1 kg (cantidad entera, caja sin actualizar)",
      "product": { "saleFormat": "GRAMS", "costPrice": "7000", "sellingPrice": "12000", "rounding": 0 },
      "unit": "KG", "quantity": "1",
      "expect": { "valid": true, "stockQty": "1.000", "unitCost": "7000.0000", "unitPrice": "12000.00", "lineTotal": "12000.00" } },
    { "name": "GRAMS: el importe se redondea a centavos",
      "product": { "saleFormat": "GRAMS", "costPrice": "7000", "sellingPrice": "12999.99", "rounding": 0 },
      "unit": "KG", "quantity": "0.333",
      "expect": { "valid": true, "stockQty": "0.333", "unitCost": "7000.0000", "unitPrice": "12999.99", "lineTotal": "4329.00" } },
    { "name": "GRAMS: no se vende por unidad",
      "product": { "saleFormat": "GRAMS", "costPrice": "7000", "sellingPrice": "12000", "rounding": 0 },
      "unit": "UNIT", "quantity": "2", "expect": { "valid": false } },
    { "name": "GRAMS: hasta 3 decimales",
      "product": { "saleFormat": "GRAMS", "costPrice": "7000", "sellingPrice": "12000", "rounding": 0 },
      "unit": "KG", "quantity": "0.3505", "expect": { "valid": false } },
    { "name": "GRAMS: peso negativo",
      "product": { "saleFormat": "GRAMS", "costPrice": "7000", "sellingPrice": "12000", "rounding": 0 },
      "unit": "KG", "quantity": "-0.100", "expect": { "valid": false } },
    { "name": "MIXED por unidad: precio derivado del kg",
      "product": { "saleFormat": "MIXED", "costPrice": "4000", "sellingPrice": "8000", "unitWeightKg": "0.250", "rounding": 0 },
      "unit": "UNIT", "quantity": "2",
      "expect": { "valid": true, "stockQty": "0.500", "unitCost": "1000.0000", "unitPrice": "2000.00", "lineTotal": "4000.00" } },
    { "name": "MIXED por unidad: precio por unidad fijado",
      "product": { "saleFormat": "MIXED", "costPrice": "4000", "sellingPrice": "8000", "unitWeightKg": "0.250", "unitPrice": "2500", "rounding": 0 },
      "unit": "UNIT", "quantity": "3",
      "expect": { "valid": true, "stockQty": "0.750", "unitCost": "1000.0000", "unitPrice": "2500.00", "lineTotal": "7500.00" } },
    { "name": "MIXED por unidad: el precio derivado respeta el redondeo del producto",
      "product": { "saleFormat": "MIXED", "costPrice": "1800", "sellingPrice": "3000", "unitWeightKg": "0.230", "rounding": 50 },
      "unit": "UNIT", "quantity": "1",
      "expect": { "valid": true, "stockQty": "0.230", "unitCost": "414.0000", "unitPrice": "700.00", "lineTotal": "700.00" } },
    { "name": "MIXED por unidad: 7 unidades de 0,333 kg",
      "product": { "saleFormat": "MIXED", "costPrice": "1000", "sellingPrice": "1500", "unitWeightKg": "0.333", "rounding": 0 },
      "unit": "UNIT", "quantity": "7",
      "expect": { "valid": true, "stockQty": "2.331", "unitCost": "333.0000", "unitPrice": "499.50", "lineTotal": "3496.50" } },
    { "name": "MIXED por peso",
      "product": { "saleFormat": "MIXED", "costPrice": "4000", "sellingPrice": "8000", "unitWeightKg": "0.250", "unitPrice": "2500", "rounding": 0 },
      "unit": "KG", "quantity": "0.400",
      "expect": { "valid": true, "stockQty": "0.400", "unitCost": "4000.0000", "unitPrice": "8000.00", "lineTotal": "3200.00" } },
    { "name": "MIXED por unidad: la cantidad debe ser entera",
      "product": { "saleFormat": "MIXED", "costPrice": "4000", "sellingPrice": "8000", "unitWeightKg": "0.250", "rounding": 0 },
      "unit": "UNIT", "quantity": "2.5", "expect": { "valid": false } }
  ]
}
